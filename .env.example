# Copy to .env. Nothing here is required for `make run`: the pipeline only reads approved seeds.
# LLM settings are needed for `make agents` and `make eval`.

# OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_BULK=gpt-5-mini
LLM_MODEL_REASONING=gpt-5-mini
LLM_PRICE_INPUT_PER_1M=0.25
LLM_PRICE_OUTPUT_PER_1M=2.00

# Local alternative (Ollama, OpenAI-compatible API). Prices stay at the OpenAI values above
# so recorded costs read as "what this would cost on the hosted model".
# Ollama's default 4k context silently truncates the DQ and schema prompts, so create a 16k variant first:
#   printf 'FROM gpt-oss:20b\nPARAMETER num_ctx 16384\n' > /tmp/Modelfile && ollama create gpt-oss-16k -f /tmp/Modelfile
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_BULK=gpt-oss-16k
# LLM_MODEL_REASONING=gpt-oss-16k

LLM_DAILY_BUDGET_USD=2.00
REPLAY_WINDOW_HOURS=48
DB_PORT=5433
